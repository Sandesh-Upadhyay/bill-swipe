# BillSwipe environment variables
# Copy to .env.local (never commit .env.local) and fill in values from:
# Supabase Dashboard → Project Settings → API Keys / Data API.

# Public values — safe in the browser. RLS policies protect the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Canonical site origin used in auth emails and OAuth redirects (no trailing slash).
# Production example: https://bill-swipe-five.vercel.app
# Leave empty locally; http://localhost:3000 is derived from the request.
NEXT_PUBLIC_SITE_URL=

# Do NOT add a secret / service-role key here or to any NEXT_PUBLIC_ variable.
# Phases 1–2 don't need one. If a later phase needs it for server-only jobs, store it as
# SUPABASE_SECRET_KEY in the hosting provider's encrypted environment settings only.
#
# Google OAuth credentials are NOT app environment variables: enter the Google Client ID and
# Client Secret in Supabase Dashboard → Authentication → Sign In / Providers → Google.
