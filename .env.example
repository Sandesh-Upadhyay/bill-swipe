# BillSwipe environment variables
# Copy to .env.local (never commit .env.local) and fill in values from:
# Supabase Dashboard → Project Settings → API Keys / Data API.

# Public values — safe in the browser. RLS policies protect the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Do NOT add a secret / service-role key here or to any NEXT_PUBLIC_ variable.
# Phase 1 doesn't need one. If a later phase needs it for server-only jobs, store it as
# SUPABASE_SECRET_KEY in the hosting provider's encrypted environment settings only.
